CHAIN_ID=BASE
# Arbitrum: CHAIN_ID=ARBITRUM / ARBITRUMN / ARBITRUMS;
# set matching NODE_RPC_URL and TRUSTED_RPC_URL explicitly.
NODE_RPC_URL=http://192.0.2.10:8545
TRUSTED_RPC_URL=https://mainnet.base.org
# WEBSOCKET_URL=ws://192.0.2.10:8546
# NODE_TYPE=prune
# ADDONS=debug,trace
# Arbitrum legacy trace verification (optional): ADDONS=arbtrace
# Alternative to NODE_RPC_URL (unset it first):
# NODES_JSON={"node-01":{"rpc_url":"http://192.0.2.10:8545","websocket_url":"ws://192.0.2.10:8546","addons":["debug"],"type":"prune"}}
POLL_INTERVAL_SECONDS=5
DEEP_CHECK_INTERVAL_SECONDS=60
STATE_TTL_SECONDS=45
# Allowed lag in blocks relative to the trusted snapshot (inclusive).
MAX_BEHIND_BLOCKS=0
TRUSTED_STATE_TTL_SECONDS=45
TRUSTED_REFRESH_INTERVAL_SECONDS=5
NODE_PROGRESS_TTL_SECONDS=30
DEEP_STATE_TTL_SECONDS=180
RPC_TIMEOUT_SECONDS=3
TRUSTED_RPC_TIMEOUT_SECONDS=5
RPC_RETRY_COUNT=2
CHECK_WORKERS=4
DEEP_CHECK_WORKERS=2
RETRY_DELAY_SECONDS=0.5
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
